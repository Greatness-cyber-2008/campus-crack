# Supabase (same project pattern as your other apps)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# AI provider for question generation and OCR fallback.
# Default is Gemini (Google) — genuinely free, no card required, get a key at
# aistudio.google.com/apikey. Switch to Anthropic later by changing AI_PROVIDER
# to "anthropic" and filling in the Anthropic keys below — no code changes needed.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Pricing (in kobo, so ₦3,500 = 350000)
NEXT_PUBLIC_PREMIUM_PRICE_KOBO=350000

# Free tier limit before paywall kicks in
FREE_GENERATIONS_LIMIT=3
FREE_MAX_QUESTIONS_PER_SET=10
FREE_CHAT_MESSAGES_PER_DAY=15

# OpenAI (server-side only). Luna is the low-cost default when OpenAI is selected.
AI_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_MONTHLY_BUDGET_USD=5.00
# Held back from the budget above as a cushion (our spend estimate can be a little low).
OPENAI_BUDGET_SAFETY_MARGIN_USD=0.50
# Set this to the OpenAI amount already spent this UTC month when first enabling the guard.
OPENAI_MONTHLY_SPEND_BASELINE_USD=0.00
OPENAI_MONTHLY_SPEND_BASELINE_MONTH=2026-10-01
OPENAI_REASONING_EFFORT=low
OPENAI_CHAT_MAX_OUTPUT_TOKENS=2500
OPENAI_GENERATION_MAX_OUTPUT_TOKENS=16000
MAX_CHAT_HISTORY_TURNS=12
# Per-student daily caps for premium users, so one student can't use up the shared AI budget.
PREMIUM_MAX_GENERATIONS_PER_DAY=15
PREMIUM_CHAT_MESSAGES_PER_DAY=100
STUDY_PLAN_MAX_COMBINED_CHARS=50000
